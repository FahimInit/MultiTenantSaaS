# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saas_platform
POSTGRES_USER=saas_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_LOCAL_DEV_PASSWORD

# API Connection String (override in Docker / Deployment)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=saas_platform;Username=saas_app;Password=CHANGE_ME_STRONG_LOCAL_DEV_PASSWORD

# JWT Settings (Minimum 32 characters for HS256; never commit real secrets)
Jwt__Issuer=https://api.saas.local
Jwt__Audience=https://app.saas.local
Jwt__SigningKey=CHANGE_ME_AT_LEAST_32_CHARS_LONG_RANDOM_SECRET_KEY
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# CORS Allowed Origins (comma-separated or indexed in ASP.NET config)
Cors__AllowedOrigins__0=http://localhost:3000

# ASP.NET Core Runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# Redis (Phase 4)
REDIS_PORT=6379
Redis__Enabled=false
Redis__ConnectionString=localhost:6379

# Rate Limiting Defaults
RateLimiting__AuthPermitLimit=20
RateLimiting__ApiPermitLimit=120

# Email (Phase 4 SMTP / Dev Sink)
Email__Provider=Development
Email__FromAddress=noreply@saas.local
Email__FromName=Multi-Tenant SaaS Platform

# Frontend (Phase 5 Next.js Dashboard)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SHOW_DEMO_HINTS=true
