# Base URL of the ASP.NET Core API (including version prefix)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Show non-production demo quick-fill hints on the login page in local development
NEXT_PUBLIC_SHOW_DEMO_HINTS=true

# Optional local demo password for one-click persona fill (set in untracked .env.local)
NEXT_PUBLIC_DEMO_PASSWORD=
